{
  "schemaVersion": 1,
  "locale": "pt-BR",
  "note": "Camada de idioma do catálogo. As entidades guardam o nome da fonte, em inglês; aqui fica o nome que o jogo usa em português. `from` diz de onde cada tradução veio: dataset (nomenclatura já curada em src/data/attachments.ts), matriz (tela Selecionar cano do jogo, comprimento x perfil) ou curadoria (traduzido seguindo o vocabulário das outras duas). Peça sem entrada aqui aparece com o nome de origem, e o validador avisa.",
  "rules": [
    {
      "slot": "magazine",
      "pattern": "^(\\d+) Rnd$",
      "template": "Carregador de $1",
      "from": "dataset",
      "note": "O dataset curado chama '30RND Magazine' de 'Carregador de 30'."
    },
    {
      "slot": "magazine",
      "pattern": "^(\\d+) Fast$",
      "template": "Carregador Rápido de $1",
      "from": "dataset",
      "note": "'10RND Fast Mag' é 'Carregador Rápido de 10'."
    }
  ],
