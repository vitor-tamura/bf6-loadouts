{
  "name": "bf6-loadouts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Montador de loadouts de Battlefield 6 em português do Brasil",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "catalog:migrate": "node --experimental-strip-types scripts/catalog/migrate.ts",
    "catalog:discover": "node --experimental-strip-types scripts/catalog/discover-updates.ts",
    "catalog:fetch-patch": "node --experimental-strip-types scripts/catalog/fetch-patch-note.ts",
    "catalog:parse-patch": "node --experimental-strip-types scripts/catalog/parse-patch-note.ts",
    "catalog:fetch-loadouts": "node --experimental-strip-types scripts/catalog/fetch-loadouts.ts",
    "catalog:fetch-github": "node --experimental-strip-types scripts/catalog/fetch-github-data.ts",
    "catalog:reconcile": "node --experimental-strip-types scripts/catalog/reconcile.ts",
    "catalog:indexes": "node --experimental-strip-types scripts/catalog/generate-indexes.ts",
    "catalog:validate": "node --experimental-strip-types scripts/catalog/validate.ts",
    "catalog:diff": "node --experimental-strip-types scripts/catalog/diff.ts",
    "catalog:build": "node --experimental-strip-types scripts/catalog/build.ts",
    "catalog": "npm run catalog:indexes && npm run catalog:validate && npm run catalog:build",
    "sync": "node --experimental-strip-types scripts/sync.mjs",
    "sync:apply": "node --experimental-strip-types scripts/sync.mjs --apply",
    "meta:search": "node --experimental-strip-types scripts/meta-search.mjs",
    "images": "node scripts/images.mjs",
    "images:download": "python3 scripts/download_images.py",
    "docs:weapons": "node scripts/weapons-doc.mjs",
    "docs:attachments": "node scripts/attachments-doc.mjs",
    "catalog:import-analyzer": "node --experimental-strip-types scripts/catalog/import-analyzer.ts",
    "catalog:coverage": "node --experimental-strip-types scripts/catalog/coverage.ts",
    "catalog:update": "node --experimental-strip-types scripts/catalog/update.ts",
    "catalog:import-ttk": "node --experimental-strip-types scripts/catalog/import-ttk-sheet.ts",
    "catalog:import-loadouts": "node --experimental-strip-types scripts/catalog/import-loadouts-page.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.39",
    "@ai-sdk/openai": "^4.0.37",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@ant-design/plots": "^2.6.8",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.58",
    "antd": "^6.5.4",
    "motion": "^13.0.0",
    "next": "16.3.0",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
