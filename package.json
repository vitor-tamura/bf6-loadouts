{
  "name": "bf6-loadouts",
  "version": "0.1.0",
  "private": true,
  "description": "Montador de loadouts de Battlefield 6 em português do Brasil",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sync": "node --experimental-strip-types scripts/sync.mjs",
    "sync:apply": "node --experimental-strip-types scripts/sync.mjs --apply",
    "images": "node scripts/images.mjs",
    "images:download": "python3 scripts/download_images.py",
    "docs:weapons": "node scripts/weapons-doc.mjs",
    "docs:attachments": "node scripts/attachments-doc.mjs"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
    "@ant-design/plots": "^2.6.8",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.58",
    "antd": "^6.5.4",
    "motion": "^13.0.0",
    "next": "16.3.0",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
